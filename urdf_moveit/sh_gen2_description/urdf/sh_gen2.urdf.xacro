<?xml version="1.0"?>
<!--
  ============================================================
  PLACEHOLDER 모델 (임시). 실제 치수/축 방향이 아닙니다.
  - 목적: URDF 팀 결과물 도착 전, 이름 규칙(NAMING)대로
          RViz / MoveIt 파이프라인을 미리 검증하기 위함
  - tools/import_urdf.py 를 실행하면 이 파일은 덮어써집니다.
  좌표계: 원점 = 받침대 바닥 중앙, +x 정면, +y 로봇 왼쪽, +z 위
  ============================================================
-->
<robot name="sh_gen2">
  <material name="grey"><color rgba="0.6 0.6 0.65 1"/></material>
  <material name="dark"><color rgba="0.15 0.15 0.15 1"/></material>
  <material name="blue"><color rgba="0.3 0.45 0.8 1"/></material>
  <material name="skin"><color rgba="0.9 0.8 0.5 1"/></material>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.01" rpy="0 0 0"/>
      <geometry><box size="0.5 0.5 0.02"/></geometry>
      <material name="dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.01" rpy="0 0 0"/>
      <geometry><box size="0.5 0.5 0.02"/></geometry>
    </collision>
    <visual>
      <origin xyz="0 0 0.53" rpy="0 0 0"/>
      <geometry><cylinder radius="0.06" length="1.02"/></geometry>
      <material name="dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.53" rpy="0 0 0"/>
      <geometry><cylinder radius="0.06" length="1.02"/></geometry>
    </collision>
    <visual>
      <origin xyz="0 0 1.08" rpy="0 0 0"/>
      <geometry><box size="0.12 0.36 0.08"/></geometry>
      <material name="dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 1.08" rpy="0 0 0"/>
      <geometry><box size="0.12 0.36 0.08"/></geometry>
    </collision>
  </link>

  <!-- ===== left arm ===== -->
  <joint name="left_shoulder_pitch_joint" type="revolute">
    <parent link="base_link"/>
    <child link="left_shoulder_pitch_link"/>
    <origin xyz="0 0.22 1.08" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.5" upper="2.5" velocity="2.0" effort="50.0"/>
  </joint>
  <link name="left_shoulder_pitch_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.045" length="0.06"/></geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.045" length="0.06"/></geometry>
    </collision>
  </link>
  <joint name="left_shoulder_roll_joint" type="revolute">
    <parent link="left_shoulder_pitch_link"/>
    <child link="left_shoulder_roll_link"/>
    <origin xyz="0 0.05 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-0.3" upper="2.2" velocity="2.0" effort="50.0"/>
  </joint>
  <link name="left_shoulder_roll_link">
    <visual>
      <origin xyz="0 0 -0.06" rpy="0 0 0"/>
      <geometry><cylinder radius="0.04" length="0.12"/></geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.06" rpy="0 0 0"/>
      <geometry><cylinder radius="0.04" length="0.12"/></geometry>
    </collision>
  </link>
  <joint name="left_shoulder_yaw_joint" type="revolute">
    <parent link="left_shoulder_roll_link"/>
    <child link="left_shoulder_yaw_link"/>
    <origin xyz="0 0 -0.12" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.0" upper="2.0" velocity="2.0" effort="50.0"/>
  </joint>
  <link name="left_shoulder_yaw_link">
    <visual>
      <origin xyz="0 0 -0.07" rpy="0 0 0"/>
      <geometry><cylinder radius="0.04" length="0.14"/></geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.07" rpy="0 0 0"/>
      <geometry><cylinder radius="0.04" length="0.14"/></geometry>
    </collision>
  </link>
  <joint name="left_elbow_joint" type="revolute">
    <parent link="left_shoulder_yaw_link"/>
    <child link="left_elbow_link"/>
    <origin xyz="0 0 -0.14" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.3" upper="0.0" velocity="2.0" effort="50.0"/>
  </joint>
  <link name="left_elbow_link">
    <visual>
      <origin xyz="0 0 -0.1" rpy="0 0 0"/>
      <geometry><cylinder radius="0.035" length="0.2"/></geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.1" rpy="0 0 0"/>
      <geometry><cylinder radius="0.035" length="0.2"/></geometry>
    </collision>
  </link>
  <joint name="left_wrist_joint" type="revolute">
    <parent link="left_elbow_link"/>
    <child link="left_wrist_link"/>
    <origin xyz="0 0 -0.2" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.8" upper="1.8" velocity="2.0" effort="50.0"/>
  </joint>
  <link name="left_wrist_link">
    <visual>
      <origin xyz="0 0 -0.07" rpy="0 0 0"/>
      <geometry><box size="0.05 0.08 0.12"/></geometry>
      <material name="skin"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.07" rpy="0 0 0"/>
      <geometry><box size="0.05 0.08 0.12"/></geometry>
    </collision>
  </link>

  <!-- ===== right arm ===== -->
  <joint name="right_shoulder_pitch_joint" type="revolute">
    <parent link="base_link"/>
    <child link="right_shoulder_pitch_link"/>
    <origin xyz="0 -0.22 1.08" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.5" upper="2.5" velocity="2.0" effort="50.0"/>
  </joint>
  <link name="right_shoulder_pitch_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.045" length="0.06"/></geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.045" length="0.06"/></geometry>
    </collision>
  </link>
  <joint name="right_shoulder_roll_joint" type="revolute">
    <parent link="right_shoulder_pitch_link"/>
    <child link="right_shoulder_roll_link"/>
    <origin xyz="0 -0.05 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-2.2" upper="0.3" velocity="2.0" effort="50.0"/>
  </joint>
  <link name="right_shoulder_roll_link">
    <visual>
      <origin xyz="0 0 -0.06" rpy="0 0 0"/>
      <geometry><cylinder radius="0.04" length="0.12"/></geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.06" rpy="0 0 0"/>
      <geometry><cylinder radius="0.04" length="0.12"/></geometry>
    </collision>
  </link>
  <joint name="right_shoulder_yaw_joint" type="revolute">
    <parent link="right_shoulder_roll_link"/>
    <child link="right_shoulder_yaw_link"/>
    <origin xyz="0 0 -0.12" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.0" upper="2.0" velocity="2.0" effort="50.0"/>
  </joint>
  <link name="right_shoulder_yaw_link">
    <visual>
      <origin xyz="0 0 -0.07" rpy="0 0 0"/>
      <geometry><cylinder radius="0.04" length="0.14"/></geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.07" rpy="0 0 0"/>
      <geometry><cylinder radius="0.04" length="0.14"/></geometry>
    </collision>
  </link>
  <joint name="right_elbow_joint" type="revolute">
    <parent link="right_shoulder_yaw_link"/>
    <child link="right_elbow_link"/>
    <origin xyz="0 0 -0.14" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.3" upper="0.0" velocity="2.0" effort="50.0"/>
  </joint>
  <link name="right_elbow_link">
    <visual>
      <origin xyz="0 0 -0.1" rpy="0 0 0"/>
      <geometry><cylinder radius="0.035" length="0.2"/></geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.1" rpy="0 0 0"/>
      <geometry><cylinder radius="0.035" length="0.2"/></geometry>
    </collision>
  </link>
  <joint name="right_wrist_joint" type="revolute">
    <parent link="right_elbow_link"/>
    <child link="right_wrist_link"/>
    <origin xyz="0 0 -0.2" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.8" upper="1.8" velocity="2.0" effort="50.0"/>
  </joint>
  <link name="right_wrist_link">
    <visual>
      <origin xyz="0 0 -0.07" rpy="0 0 0"/>
      <geometry><box size="0.05 0.08 0.12"/></geometry>
      <material name="skin"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.07" rpy="0 0 0"/>
      <geometry><box size="0.05 0.08 0.12"/></geometry>
    </collision>
  </link>
</robot>
